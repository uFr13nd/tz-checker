# Пример reverse-proxy для TZ Checker.
# 1) Замените tz.example.com на свой домен.
# 2) Получите сертификат: certbot --nginx -d tz.example.com
# 3) Приложение слушает 127.0.0.1:8000 (как в docker-compose.yml).

server {
    listen 80;
    server_name tz.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name tz.example.com;

    ssl_certificate     /etc/letsencrypt/live/tz.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tz.example.com/privkey.pem;

    client_max_body_size 100m;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
