# Скопируйте в .env и заполните. Файл .env не должен попадать в репозиторий.
# Токен доступа обязателен для серверного развёртывания.
TZ_CHECKER_TOKEN=change-me-please

# Хранилище (в Docker уже задано /data)
TZ_CHECKER_DATA_DIR=./data

# Провайдер по умолчанию (можно оставить пустым и настроить в интерфейсе).
# Значения из окружения имеют приоритет над data/settings.json.
TZ_CHECKER_BASE_URL=https://api.openai.com/v1
TZ_CHECKER_MODEL=gpt-4.1-mini
# TZ_CHECKER_API_KEY=sk-...

# Ограничения и производительность
TZ_CHECKER_MAX_UPLOAD_MB=20
TZ_CHECKER_CONCURRENCY=3
TZ_CHECKER_USE_EMBEDDINGS=1
TZ_CHECKER_EMBEDDING_MODEL=nomic-embed-text
# Отдельный адрес для эмбеддингов (например, локальная Ollama при облачном чате).
# Пусто — используется основной Base URL.
TZ_CHECKER_EMBEDDING_BASE_URL=
TZ_CHECKER_EMBEDDING_API_KEY=

# Цены для оценки стоимости, $ за 1M токенов
TZ_CHECKER_PRICE_INPUT=0
TZ_CHECKER_PRICE_OUTPUT=0

# CORS/Origin: дополнительные разрешённые адреса через запятую
# TZ_CHECKER_ORIGINS=https://tz.example.com

# OCR (требует Tesseract и requirements-ocr.txt)
TZ_CHECKER_OCR=0

TZ_CHECKER_LOG_LEVEL=INFO
